{
  "name": "calendared",
  "version": "0.1.0",
  "description": "Keep your days, weeks, months, quarters, and years calendared. Open periodic notes from a calendar, breadcrumbs, and a mini calendar, and mark each one with an emoji sticker.",
  "author": "small-spring",
  "main": "dist/main.js",
  "type": "module",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24",
    "npm": ">=11.19"
  },
  "scripts": {
    "dev": "vite build --mode development --watch",
    "build": "npm run lint && npm run check && npm run adr -- --check && vite build --mode production",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --threshold error --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:dst": "TZ=America/Santiago vitest run",
    "lint": "eslint ./src",
    "lint-fix": "npm run check && eslint --fix ./src",
    "deploy": "scripts/deploy.sh",
    "adr": "node scripts/adr-index.mjs",
    "emoji-language": "node scripts/add-emoji-language.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tsconfig/svelte": "^5.0.4",
    "@types/node": "^24.19.2",
    "autoprefixer": "^10.4.20",
    "builtin-modules": "^4.0.0",
    "cldr-annotations-derived-full": "^48.2.0",
    "cldr-annotations-full": "^48.2.0",
    "eslint": "^9.39.1",
    "eslint-plugin-obsidianmd": "^0.1.9",
    "globals": "^16.5.0",
    "moment": "^2.29.4",
    "obsidian": "^1.13.1",
    "postcss": "^8.4.47",
    "svelte": "^5.57.2",
    "svelte-check": "^4.0.5",
    "tailwindcss": "^3.4.14",
    "tslib": "^2.4.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.49.0",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@floating-ui/dom": "^1.5.1",
    "clsx": "^2.0.0",
    "emoji-mart": "^5.6.0",
    "emoji-regex": "^10.4.0",
    "svelte-writable-derived": "^3.1.1",
    "tailwind-merge": "^2.5.4"
  }
}
