engine-strict=true
# Calendared: upstream also had `resolution-mode=highest`, which current npm no longer supports (it only printed warnings)

# Calendared: supply-chain safety (see CUSTOMIZATIONS.md)
# never run dependency install scripts (preinstall/postinstall/...)
ignore-scripts=true
# only install versions published at least 14 days ago, so freshly hijacked releases are usually caught first
min-release-age=14
